  "type": "object",
  "properties": {
    "catalogItemField": {
      "type": "string"
    },
    "variablesField": {
      "type": "string"
    },
    "taskEntity": {
      "type": "string"
    },
    "taskRequestField": {
      "type": "string"
    },
    "taskKeyField": {
      "type": "string"
    },
    "taskTitleField": {
      "type": "string"
    },
    "taskDescriptionField": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskGroupField": {
      "type": [
        "string",
        "null"
      ]
    },
    "startStates": {
