{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/workflow.schema.json",
  "title": "WorkflowSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "stateField": {
      "type": "string"
    },
    "initialState": {
      "type": "string"
    },
    "definitionVersion": {
      "type": "integer"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category"
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to": {
            "type": "string"
          },
          "guard": {
            "type": [
              "string",
              "null"
            ]
          },
          "guardMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiredFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tone": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "system": {
            "type": "boolean"
          },
          "emits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "severity": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "to"
        ]
      }
    },
    "activeInstances": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "stateMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cancelState": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "id",
    "entity",
    "stateField",
    "initialState"
  ]
}
