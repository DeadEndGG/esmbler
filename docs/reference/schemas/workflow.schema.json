{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/workflow.schema.json",
  "title": "WorkflowSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "stateField": {
      "type": "string"
    },
    "initialState": {
      "type": "string"
    },
    "definitionVersion": {
      "type": "integer"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category"
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to": {
            "type": "string"
          },
          "guard": {
            "type": [
              "string",
              "null"
            ]
          },
          "guardMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiredFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "to"
        ]
      }
    }
  },
  "required": [
    "id",
    "entity",
    "stateField",
    "initialState"
  ]
}
