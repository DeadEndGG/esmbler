{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/notification_template.schema.json",
  "title": "NotificationTemplateSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "event": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "body"
        ]
      }
    },
    "externalFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "subject",
    "body"
  ]
}
