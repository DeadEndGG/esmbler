{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/permission_set.schema.json",
  "title": "PermissionSetSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "create": {
            "type": "boolean"
          },
          "read": {
            "type": "string"
          },
          "update": {
            "type": "string"
          },
          "delete": {
            "type": "boolean"
          },
          "updateCondition": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity"
        ]
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "access": {
            "type": "string"
          }
        },
        "required": [
          "entity",
          "field",
          "access"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "label"
  ]
}
