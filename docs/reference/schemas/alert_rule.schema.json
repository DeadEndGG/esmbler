{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/alert_rule.schema.json",
  "title": "AlertRuleSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "minSeverity": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "dedupKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "owner": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ]
    },
    "escalation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "afterMinutes": {
            "type": "integer"
          },
          "unlessAcknowledged": {
            "type": "boolean"
          },
          "repeatEveryMinutes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "resolveOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopenWithinMinutes": {
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "trigger",
    "title"
  ]
}
