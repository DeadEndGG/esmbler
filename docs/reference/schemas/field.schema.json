{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/field.schema.json",
  "title": "FieldSpec",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "type": [
        "string",
        "null"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean"
    },
    "hidden": {
      "type": "boolean"
    },
    "deprecated": {
      "type": "boolean"
    },
    "system": {
      "type": "boolean"
    },
    "maxLength": {
      "type": [
        "integer",
        "null"
      ]
    },
    "minLength": {
      "type": [
        "integer",
        "null"
      ]
    },
    "min": {
      "type": [
        "number",
        "null"
      ]
    },
    "max": {
      "type": [
        "number",
        "null"
      ]
    },
    "scale": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pattern": {
      "type": [
        "string",
        "null"
      ]
    },
    "patternMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "choiceList": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "unique": {
      "type": "boolean"
    },
    "default": true,
    "defaultExpression": {
      "type": [
        "string",
        "null"
      ]
    },
    "maxItems": {
      "type": [
        "integer",
        "null"
      ]
    },
    "prefix": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "key",
    "type",
    "label"
  ]
}
