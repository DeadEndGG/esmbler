{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/catalog_item.schema.json",
  "title": "CatalogItemSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestEntity": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "order": {
      "type": "integer"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "help": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "choiceList": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxLength": {
            "type": [
              "integer",
              "null"
            ]
          },
          "min": {
            "type": [
              "number",
              "null"
            ]
          },
          "max": {
            "type": [
              "number",
              "null"
            ]
          },
          "scale": {
            "type": [
              "integer",
              "null"
            ]
          },
          "default": true
        },
        "required": [
          "key",
          "label",
          "type"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignmentGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "when": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "approvalPolicy": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "label",
    "requestEntity"
  ]
}
