{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/specs/notification_route.schema.json",
  "title": "NotificationRouteSpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "subscription": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ]
      }
    },
    "mandatory": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "subscription",
    "profile",
    "template"
  ]
}
