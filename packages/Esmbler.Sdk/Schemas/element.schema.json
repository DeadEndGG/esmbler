{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esmbler.dev/registry/element.schema.json",
  "title": "Element definition",
  "description": "Self-describing element registry entry. Consumed by the renderer, the configuration compiler, and the AI builder (via MCP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "category", "gate", "label", "description", "propsSchema", "accessibility", "examples"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$", "description": "Stable element ID, e.g. layout.card, field.short_text, spec_object.entity." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": { "enum": ["spec_object", "layout", "field_type", "field", "display", "collection", "activity", "action", "feedback"] },
    "gate": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Delivery gate that introduced the element." },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20, "description": "What the element is and when to use it, written for an LLM." },
    "usage": { "type": "array", "items": { "type": "string" }, "description": "Do-guidance for the AI builder." },
    "constraints": { "type": "array", "items": { "type": "string" }, "description": "Hard rules enforced by the compiler, stated plainly." },
    "placeable": { "type": "boolean", "description": "True if the element can be a node in a page layout tree." },
    "propsSchema": { "type": "object", "description": "JSON Schema 2020-12 for node props (or for the spec object)." },
    "valueSchema": { "type": "object", "description": "Field types only: JSON Schema of the stored value." },
    "allowedParents": { "type": "array", "items": { "type": "string" } },
    "allowedChildren": { "type": "array", "items": { "type": "string" } },
    "maxChildren": { "type": ["integer", "null"], "minimum": 0 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["none", "field", "record", "query", "relationship", "workflow"] },
        "description": { "type": "string" }
      }
    },
    "events": { "type": "array", "items": { "type": "string" } },
    "ruleHooks": { "type": "array", "items": { "enum": ["required", "visible", "read_only", "options", "value", "message"] } },
    "tokens": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" }, "description": "Design tokens the element uses. Specs never contain raw styling." },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "keyboard"],
      "properties": {
        "role": { "type": "string" },
        "keyboard": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "responsive": { "type": "string" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "spec"],
        "properties": {
          "description": { "type": "string" },
          "spec": {}
        }
      }
    }
  }
}
