{
  "description": "Shared conformance cases for the C# and TypeScript evaluators (ADR 0009). Each case has expr, optional vars, and either expect (value) or error (code). There is a single number type (IEEE double).",
  "vars": {
    "record": { "category": 8, "priority": 2, "title": "VPN down", "justification": null, "tags": ["network", "vpn"], "cost": 12.5, "status": "open", "nested": { "a": 1 } },
    "user": { "id": "u1", "roles": ["agent"] }
  },
  "cases": [
    { "expr": "1 + 2 * 3", "expect": 7 },
    { "expr": "(1 + 2) * 3", "expect": 9 },
    { "expr": "7 / 2", "expect": 3.5 },
    { "expr": "7 % 3", "expect": 1 },
    { "expr": "7.5 % 2", "expect": 1.5 },
    { "expr": "-3 + 1", "expect": -2 },
    { "expr": "1 / 0", "error": "expr.divide_by_zero" },
    { "expr": "0.1 + 0.2 > 0.3", "expect": true },
    { "expr": "'a' + 'b'", "expect": "ab" },
    { "expr": "[1, 2] + [3]", "expect": [1, 2, 3] },
    { "expr": "record.category == 8", "expect": true },
    { "expr": "record.category == 8.0", "expect": true },
    { "expr": "record.category != 8", "expect": false },
    { "expr": "record.priority < 3", "expect": true },
    { "expr": "record.cost >= 12.5", "expect": true },
    { "expr": "'abc' < 'abd'", "expect": true },
    { "expr": "record.missing == null", "expect": true },
    { "expr": "record.justification == null", "expect": true },
    { "expr": "record.missing < 3", "expect": false },
    { "expr": "record.missing > 3", "expect": false },
    { "expr": "record.missing + 1 == null", "expect": true },
    { "expr": "record.nested.a", "expect": 1 },
    { "expr": "record.missing.deeper", "expect": null },
    { "expr": "record.title.size", "error": "expr.type_error" },
    { "expr": "has(record.title)", "expect": true },
    { "expr": "has(record.justification)", "expect": false },
    { "expr": "has(record.missing)", "expect": false },
    { "expr": "size(record.title)", "expect": 8 },
    { "expr": "record.title.size()", "expect": 8 },
    { "expr": "size(record.tags)", "expect": 2 },
    { "expr": "size(record.missing)", "expect": 0 },
    { "expr": "'vpn' in record.tags", "expect": true },
    { "expr": "'email' in record.tags", "expect": false },
    { "expr": "'agent' in user.roles", "expect": true },
    { "expr": "1 in record.missing", "expect": false },
    { "expr": "record.status in ['open', 'pending']", "expect": true },
    { "expr": "record.title.startsWith('VPN')", "expect": true },
    { "expr": "record.title.endsWith('down')", "expect": true },
    { "expr": "record.title.contains('N d')", "expect": true },
    { "expr": "record.missing.contains('x')", "expect": false },
    { "expr": "record.title.matches('^[A-Z]+ [a-z]+$')", "expect": true },
    { "expr": "'12345'.matches('^[0-9]+$')", "expect": true },
    { "expr": "'12a45'.matches('^[0-9]+$')", "expect": false },
    { "expr": "record.title.lowerAscii()", "expect": "vpn down" },
    { "expr": "record.title.upperAscii()", "expect": "VPN DOWN" },
    { "expr": "'  x '.trim()", "expect": "x" },
    { "expr": "int('42')", "expect": 42 },
    { "expr": "int(3.9)", "expect": 3 },
    { "expr": "int('x')", "error": "expr.conversion" },
    { "expr": "double('2.5')", "expect": 2.5 },
    { "expr": "string(8)", "expect": "8" },
    { "expr": "string(true)", "expect": "true" },
    { "expr": "true && false", "expect": false },
    { "expr": "true || false", "expect": true },
    { "expr": "!true", "expect": false },
    { "expr": "false && (1 / 0 == 1)", "expect": false },
    { "expr": "(1 / 0 == 1) && false", "expect": false },
    { "expr": "true || (1 / 0 == 1)", "expect": true },
    { "expr": "(1 / 0 == 1) || true", "expect": true },
    { "expr": "(1 / 0 == 1) || false", "error": "expr.divide_by_zero" },
    { "expr": "1 && true", "error": "expr.type_mismatch", "phase": "check" },
    { "expr": "record.category == 8 ? 'needs' : 'ok'", "expect": "needs" },
    { "expr": "record.tags[0]", "expect": "network" },
    { "expr": "record.tags[5]", "error": "expr.index_out_of_range" },
    { "expr": "[1, 2] == [1, 2]", "expect": true },
    { "expr": "'a' == 1", "error": "expr.type_mismatch", "phase": "check" },
    { "expr": "unknownVar == 1", "error": "expr.unknown_variable", "phase": "check" },
    { "expr": "foo(1)", "error": "expr.unknown_function", "phase": "check" },
    { "expr": "1 +", "error": "expr.syntax", "phase": "check" },
    { "expr": "'unterminated", "error": "expr.syntax", "phase": "check" },
    { "expr": "record.category == 8 && !has(record.justification)", "expect": true }
  ]
}
