          "kind": "callout",
          "tone": "warning",
          "visibleWhenContains": "assignee"
        }
      ]
    },
    {
      "id": "select-field-with-options",
      "tags": [
        "scripted",
        "fields"
      ],
      "prompt": "Add a dropdown field \"Channel\" with options Email, Phone and Portal",
