{
  "$comment": "AI builder evaluation cases (G1-M16). Each case runs against a fresh tenant draft; checks read the draft back through MCP. The scripted planner must pass all cases with tag 'scripted'; the model-driven planner is scored on every case for each provider whose key is set (ANTHROPIC_API_KEY, OPENAI_API_KEY).",
  "cases": [
    {
      "id": "add-required-field-in-card",
      "tags": [
        "scripted",
        "fields",
        "layout"
      ],
      "prompt": "Add a required \"Customer impact\" field to tickets and put it in the Details card",
      "checks": [
        {
          "kind": "field",
          "label": "Customer impact",
          "required": true
        },
        {
          "kind": "placed",
          "label": "Customer impact",
          "card": "Details"
        }
      ]
    },
    {
      "id": "point-and-prompt-here",
      "tags": [
        "scripted",
        "layout",
        "selection"
      ],
      "prompt": "Add a \"Vendor\" field here",
      "selection": [
        {
          "view": "core.tickets.record",
          "node": "core.tickets.record.card_assignment",
          "type": "layout.card",
          "label": "Assignment"
        }
      ],
      "checks": [
        {
          "kind": "field",
          "label": "Vendor"
        },
        {
          "kind": "placed",
          "label": "Vendor",
          "card": "Assignment"
        }
      ]
    },
    {
      "id": "conditional-require-creates-field",
      "tags": [
        "scripted",
        "rules"
      ],
      "prompt": "When priority is P1, require an impact description",
      "checks": [
        {
          "kind": "field",
          "label": "Impact description"
        },
        {
          "kind": "rule",
          "action": "require",
          "label": "Impact description",
          "whenContains": "record.priority"
        }
      ]
    },
    {
      "id": "callout-when-unassigned",
