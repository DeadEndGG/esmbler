<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- CA1848/CA1873 (LoggerMessage), CA2007 (ConfigureAwait), CA1062 (null args on public API) are noise for this codebase. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1062;CA1716;CA1711;CA1720;CA1724;CA1805;CA2227;CA1002;CA1819;CA1308;CA1031;CA1034;CA1056;CA1054;CA1055;CA2234;CA1515;CA1812;CA1859;CA1822;CA1307;CA1310;CA1304;CA1305;CA1311;CA1309</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;CA1825;CA2000;CA5394;CA1001;CA1063;CA1816</NoWarn>
  </PropertyGroup>
</Project>
