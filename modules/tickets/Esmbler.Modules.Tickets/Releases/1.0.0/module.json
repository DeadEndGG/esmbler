  "assignmentRules": [
    {
      "id": "core.tickets.assign.network",
      "entity": "core.tickets.ticket",
      "description": "Network issues go to the Network team",
      "when": "record.category == 'network'",
      "group": "network",
      "order": 10
    },
    {
      "id": "core.tickets.assign.default",
      "entity": "core.tickets.ticket",
      "description": "Everything else goes to the Service Desk",
      "when": "true",
      "group": "service_desk",
      "order": 100
    }
  ],
  "notificationTemplates": [
    {
      "id": "core.tickets.notify.resolved",
      "event": "record.transitioned:resolved",
      "entity": "core.tickets.ticket",
      "recipients": [
        "requester"
      ],
      "subject": "Resolved: {{record.title}}",
      "body": "Your ticket {{record.number}} was resolved.\n\n{{record.resolution_notes}}\n\nReply to reopen it, or confirm the resolution in the portal."
    },
    {
      "id": "core.tickets.notify.assigned",
      "event": "record.updated:assignee",
      "entity": "core.tickets.ticket",
      "recipients": [
        "assignee"
      ],
      "subject": "Assigned to you: {{record.title}}",
      "body": "Ticket {{record.number}} is now assigned to you."
    }
  ],
  "extensionPoints": [
    {
      "id": "core.tickets.hooks.before_write",
      "kind": "lifecycle_hook",
      "version": "1.0.0",
      "cardinality": "ordered_pipeline",
      "description": "Synchronous, deterministic validators run before a ticket is created or updated. Must not call the network."
    },
    {
      "id": "core.tickets.hooks.after_write",
      "kind": "lifecycle_hook",
      "version": "1.0.0",
      "cardinality": "multiple",
      "description": "Asynchronous subscribers notified after a ticket change commits (at-least-once)."
    },
    {
      "id": "core.tickets.strategy.assignment",
      "kind": "strategy",
      "version": "1.0.0",
      "cardinality": "single_provider",
      "description": "Chooses the assignment group for new tickets. Default: ordered assignment rules."
    },
    {
      "id": "core.tickets.slots.record_side_panel",
      "kind": "ui_slot",
      "version": "1.0.0",
      "cardinality": "multiple",
      "description": "Cards contributed to the right column of the ticket record page."
    }
  ],
