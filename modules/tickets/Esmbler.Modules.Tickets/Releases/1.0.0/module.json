{
  "id": "core.tickets",
  "version": "1.0.0",
  "name": "Tickets",
  "description": "Service requests and IT tickets: intake, triage, assignment, resolution, and requester confirmation.",
  "dependencies": {
    "core.platform": "^1.0.0"
  },
  "entities": [
    {
      "id": "core.tickets.ticket",
      "label": "Ticket",
      "pluralLabel": "Tickets",
      "titleField": "title",
      "description": "A request for help or service raised by a requester and worked by agents.",
      "fields": [
        {
          "key": "number",
          "type": "auto_number",
          "label": "Number",
          "prefix": "TCK",
          "system": true,
          "readOnly": true,
          "description": "Human-friendly ticket ID, unique per environment."
        },
        {
          "key": "title",
          "type": "short_text",
          "label": "Title",
          "required": true,
          "maxLength": 200,
          "description": "One-line summary of the request or problem."
        },
        {
          "key": "description",
          "type": "rich_text",
          "label": "Description",
          "maxLength": 20000
        },
        {
          "key": "status",
          "type": "status",
          "label": "Status",
          "choiceList": "core.tickets.status",
          "default": "new",
          "readOnly": true,
          "description": "Changed only through workflow transitions."
        },
        {
          "key": "priority",
          "type": "priority",
          "label": "Priority",
          "choiceList": "core.tickets.priority",
          "default": "p3",
          "required": true
        },
        {
          "key": "category",
          "type": "single_select",
          "label": "Category",
          "choiceList": "core.tickets.category"
        },
        {
          "key": "labels",
          "type": "multi_select",
          "label": "Labels",
          "choiceList": "core.tickets.labels"
        },
        {
          "key": "requester",
          "type": "user",
          "label": "Requester",
          "required": true,
          "defaultExpression": "user.id",
          "description": "Person the ticket is for. Defaults to whoever creates it."
        },
        {
          "key": "contact_email",
          "type": "email",
          "label": "Contact email",
          "maxLength": 254
        },
        {
          "key": "assignment_group",
          "type": "group",
          "label": "Assignment group"
        },
        {
          "key": "assignee",
          "type": "user",
          "label": "Assignee"
        },
        {
          "key": "parent",
          "type": "lookup",
          "label": "Parent ticket",
          "target": "core.tickets.ticket"
        },
        {
          "key": "estimated_effort",
          "type": "short_text",
          "label": "Estimated effort",
          "maxLength": 40,
          "help": "Hours, e.g. 4 or 2.5"
        },
        {
          "key": "resolution_notes",
          "type": "long_text",
          "label": "Resolution notes",
          "maxLength": 4000
        },
        {
          "key": "resolved_at",
          "type": "date_time",
          "label": "Resolved at",
          "readOnly": true
        },
        {
          "key": "confirmed",
          "type": "toggle",
          "label": "Requester confirmed",
          "readOnly": true,
          "default": false
        },
        {
          "key": "reopen_count",
          "type": "integer",
          "label": "Times reopened",
          "readOnly": true,
          "default": 0,
          "min": 0
        },
        {
          "key": "created_at",
          "type": "date_time",
          "label": "Created",
          "system": true,
          "readOnly": true
        },
        {
          "key": "updated_at",
          "type": "date_time",
          "label": "Updated",
          "system": true,
          "readOnly": true
        }
      ],
      "accessFields": [
        {
          "field": "requester",
          "relation": "requester",
          "canEdit": true
        },
        {
          "field": "assignee",
          "relation": "assignee",
          "canEdit": true
        },
        {
          "field": "assignment_group",
          "relation": "owner_group",
          "canEdit": true
        }
      ]
    }
  ],
  "choiceLists": [
    {
      "id": "core.tickets.status",
      "label": "Ticket status",
      "options": [
        {
          "id": "new",
          "label": "New",
          "tone": "accent.gray"
        },
        {
          "id": "assigned",
          "label": "Assigned",
          "tone": "accent.blue"
        },
        {
          "id": "in_progress",
          "label": "In progress",
          "tone": "accent.purple"
        },
        {
          "id": "on_hold",
          "label": "On hold",
          "tone": "accent.amber"
        },
        {
          "id": "resolved",
          "label": "Resolved",
          "tone": "accent.green"
        },
        {
          "id": "closed",
          "label": "Closed",
          "tone": "accent.gray"
        },
        {
          "id": "cancelled",
          "label": "Cancelled",
          "tone": "accent.gray"
        }
      ]
    },
    {
      "id": "core.tickets.priority",
      "label": "Priority",
      "options": [
        {
          "id": "p1",
          "label": "Critical",
          "tone": "accent.red"
        },
        {
          "id": "p2",
          "label": "High",
          "tone": "accent.amber"
        },
        {
          "id": "p3",
          "label": "Medium",
          "tone": "accent.blue"
        },
        {
          "id": "p4",
          "label": "Low",
          "tone": "accent.gray"
        }
      ]
    },
    {
      "id": "core.tickets.category",
      "label": "Category",
      "options": [
        {
          "id": "hardware",
          "label": "Hardware"
        },
        {
          "id": "software",
          "label": "Software"
        },
        {
          "id": "network",
          "label": "Network"
        },
        {
          "id": "access",
          "label": "Access request"
        },
        {
          "id": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "core.tickets.labels",
      "label": "Labels",
      "options": [
        {
          "id": "vip",
          "label": "VIP",
          "tone": "accent.purple"
        },
        {
          "id": "outage",
          "label": "Outage",
          "tone": "accent.red"
        },
        {
          "id": "security",
          "label": "Security",
          "tone": "accent.amber"
        },
        {
          "id": "onboarding",
          "label": "Onboarding",
          "tone": "accent.green"
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "core.tickets.parent_child",
      "kind": "lookup",
      "entity": "core.tickets.ticket",
      "field": "parent",
      "target": "core.tickets.ticket",
      "label": "Parent ticket",
      "inverseLabel": "Child tickets",
      "onTargetDelete": "restrict"
    }
  ],
  "rules": [
    {
      "id": "core.tickets.rules.title_length",
      "kind": "validation",
      "scope": "data",
      "entity": "core.tickets.ticket",
      "description": "Titles need at least 5 characters",
      "assert": "record.title.size() >= 5",
      "field": "title",
      "message": "Write a title of at least 5 characters so agents can triage it.",
      "order": 10
    },
    {
      "id": "core.tickets.rules.resolution_notes",
      "kind": "conditional",
      "scope": "data",
      "entity": "core.tickets.ticket",
      "description": "Resolved and closed tickets need resolution notes",
      "when": "record.status in ['resolved', 'closed']",
      "actions": [
        {
          "type": "require",
          "field": "resolution_notes",
          "message": "Describe how the ticket was resolved."
        }
      ],
      "order": 20
    },
    {
      "id": "core.tickets.rules.closed_read_only",
      "kind": "conditional",
      "scope": "data",
      "entity": "core.tickets.ticket",
      "description": "Closed tickets are read-only",
      "when": "record.status in ['closed', 'cancelled']",
      "actions": [
        {
          "type": "read_only",
          "field": "title"
        },
        {
          "type": "read_only",
          "field": "description"
        },
        {
          "type": "read_only",
          "field": "priority"
        },
        {
          "type": "read_only",
          "field": "category"
        }
      ],
      "order": 30
    }
  ],
  "workflows": [
    {
      "id": "core.tickets.lifecycle",
      "entity": "core.tickets.ticket",
      "stateField": "status",
      "initialState": "new",
      "definitionVersion": 1,
      "states": [
        {
          "id": "new",
          "category": "new"
        },
        {
          "id": "assigned",
          "category": "active"
        },
        {
          "id": "in_progress",
          "category": "active"
        },
        {
          "id": "on_hold",
          "category": "pending"
        },
        {
          "id": "resolved",
          "category": "resolved"
        },
        {
          "id": "closed",
          "category": "closed"
        },
        {
          "id": "cancelled",
          "category": "cancelled"
        }
      ],
      "transitions": [
        {
          "id": "assign",
          "label": "Assign",
          "from": [
            "new"
          ],
          "to": "assigned",
          "requiredFields": [
            "assignment_group"
          ],
          "roles": [
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "tone": "primary"
        },
        {
          "id": "start",
          "label": "Start work",
          "from": [
            "new",
            "assigned"
          ],
          "to": "in_progress",
          "roles": [
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "set": {
            "assignee": "has(record.assignee) ? record.assignee : user.id"
          },
          "tone": "primary"
        },
        {
          "id": "hold",
          "label": "Put on hold",
          "from": [
            "assigned",
            "in_progress"
          ],
          "to": "on_hold",
          "roles": [
            "core.tickets.agent",
            "core.tickets.admin"
          ]
        },
        {
          "id": "resume",
          "label": "Resume",
          "from": [
            "on_hold"
          ],
          "to": "in_progress",
          "roles": [
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "tone": "primary"
        },
        {
          "id": "resolve",
          "label": "Resolve",
          "from": [
            "assigned",
            "in_progress",
            "on_hold"
          ],
          "to": "resolved",
          "requiredFields": [
            "resolution_notes"
          ],
          "roles": [
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "set": {
            "resolved_at": "now"
          },
          "tone": "primary"
        },
        {
          "id": "confirm",
          "label": "Confirm resolution",
          "from": [
            "resolved"
          ],
          "to": "closed",
          "roles": [
            "core.tickets.requester",
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "set": {
            "confirmed": "true"
          },
          "tone": "primary"
        },
        {
          "id": "reopen",
          "label": "Reopen",
          "from": [
            "resolved"
          ],
          "to": "in_progress",
          "roles": [
            "core.tickets.requester",
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "set": {
            "reopen_count": "(has(record.reopen_count) ? record.reopen_count : 0) + 1",
            "resolved_at": "null",
            "confirmed": "false"
          }
        },
        {
          "id": "cancel",
          "label": "Cancel",
          "from": [
            "new",
            "assigned",
            "in_progress",
            "on_hold"
          ],
          "to": "cancelled",
          "roles": [
            "core.tickets.requester",
            "core.tickets.agent",
            "core.tickets.admin"
          ],
          "tone": "danger"
        }
      ]
    }
  ],
